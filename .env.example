# Copy to .env.local and fill in. .env.local is gitignored.
# One AI provider is enough (D-057). Claude is used when its key is set,
# otherwise Gemini. SORTIE_LLM=claude|gemini forces one.
ANTHROPIC_API_KEY=
# Gemini: a key from https://aistudio.google.com/apikey on a project WITH
# billing enabled. The free tier may use what you send (your resume) to improve
# Google products, and Google says not to send personal data to it.
GEMINI_API_KEY=
# SORTIE_LLM=gemini

# Optional
# SORTIE_MODEL=claude-opus-5-5           # resume reading, tailoring, truth check (Gemini default: gemini-4-argon)
# SORTIE_BULK_MODEL=claude-sonnet-5-5     # answers to form questions (Gemini default: gemini-3.8-flash)
# SORTIE_REVIEW_MODEL=claude-haiku-5-5    # job reviews (Gemini default: gemini-3.8-flash)
# SORTIE_REVIEWS_PER_CYCLE=40
# SORTIE_TAILOR_PER_CYCLE=10
# SORTIE_APPLY_PER_CYCLE=10              # forms filled and checked per cycle
# SORTIE_AUTO_SUBMIT=off                 # "on" lets searches in auto mode send forms that need no person (D-056); "all" also sends Claude's answers (D-060)
# SORTIE_HANDOFF_MINUTES=20              # how long "Open in Chrome" waits for you to submit
# SORTIE_FETCH_HOURS=2
# SORTIE_CHROME_PATH=                     # only if Google Chrome isn't installed
# SORTIE_DATA_DIR=./data

