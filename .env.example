# Copy to .env.local and fill in. .env.local is gitignored.
ANTHROPIC_API_KEY=

# Optional
# SORTIE_MODEL=claude-opus-5-5           # resume reading, tailoring, truth check
# SORTIE_BULK_MODEL=claude-sonnet-5-5     # job reviews, answers to form questions
# SORTIE_REVIEWS_PER_CYCLE=40
# SORTIE_TAILOR_PER_CYCLE=10
# SORTIE_APPLY_PER_CYCLE=10              # forms filled and checked per cycle
# SORTIE_AUTO_SUBMIT=off                 # "on" lets searches in auto mode send forms that need no person (D-056)
# SORTIE_HANDOFF_MINUTES=20              # how long "Open in Chrome" waits for you to submit
# SORTIE_FETCH_HOURS=2
# SORTIE_CHROME_PATH=                     # only if Google Chrome isn't installed
# SORTIE_DATA_DIR=./data

